{
    "name": "itmosoft/laravel-query-filters",
    "description": "A lightweight, allowlist-based query filtering, searching, and sorting package for Laravel Eloquent.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "ItmoSoft\\QueryFilters\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ItmoSoft\\QueryFilters\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "ItmoSoft\\QueryFilters\\QueryFiltersServiceProvider"
            ]
        }
    }
}
